{
  "name": "yunet-resnet50-finetuned",
  "dataset": "data/lfw",
  "face_detection_model": "yunet",
  "face_recognition_model": "resnet50",
  "parameters": {
    "threshold": 0.6,
    "crop_padding": 0.25,
    "image_size": 224,
    "fine_tune_epochs": 5,
    "learning_rate": 0.0001
  },
  "dataset_parameters": {
    "sample_size": 25,
    "n_classes": 15,
    "min_photos_per_class": 4,
    "train_ratio": 0.34,
    "validation_ratio": 0.33,
    "test_ratio": 0.33
  }
}